# X Layer Deployment Configuration
# Copy to .env and fill in your values

# Private key (without 0x prefix)
# Generate with: cast wallet new
PRIVATE_KEY=your_private_key_here

# X Layer Testnet RPC
XLAYER_TESTNET_RPC=https://rpc.xlayer.tech/testnet

# X Layer Mainnet RPC (for production)
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech

# Etherscan API Key for verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Contract Addresses (will be filled after deployment)
TASK_MANAGER_ADDRESS=
PAYMENT_HUB_ADDRESS=

# USDC on X Layer Testnet
USDC_TESTNET_ADDRESS=0xcb8bf24c6ce16ad21d707c9505421a17f2bec79d

# Charlie 8004 Agent Registry (X Layer Testnet)
# Need to verify this address
AGENT_REGISTRY_8004=0x0000000000000000000000000000000000000000

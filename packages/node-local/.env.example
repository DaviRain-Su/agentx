# ── AI 后端（你自己负责，网络不管）────────────────────────────────────────────
# 如果你已经在用 Claude Code，ANTHROPIC_API_KEY 可能已经在你的环境变量里了，
# 无需重复配置。如果 chat 请求失败，是你自己的 AI 后端问题，跟网络无关。
ANTHROPIC_API_KEY=      # 已有则留空，从系统环境读取
BACKEND=claude          # "claude" 或 "pi"
CLAUDE_MODEL=claude-sonnet-4-6

# ── Agent 身份（加入网络用）──────────────────────────────────────────────────
AGENT_NAME=             # 留空则自动用机器名（hostname）
AGENT_DESCRIPTION=      # 留空则自动生成

# ── 网络 ──────────────────────────────────────────────────────────────────────
PORT=8787
# 留空则自动起 cloudflared 隧道（需要安装：brew install cloudflare/cloudflare/cloudflared）
# 或者填你的 Tailscale Funnel URL、ngrok URL 等
TUNNEL_URL=
SKIP_TUNNEL=false       # true = 仅本地，不加入公网

# ── 链上注册（可选）──────────────────────────────────────────────────────────
# 填了才会在 X Layer 上注册，让前端市场能发现你
NODE_PRIVATE_KEY=
RPC_URL=https://xlayertestrpc.okx.com
FEE_PER_CALL=0
REGISTER=true

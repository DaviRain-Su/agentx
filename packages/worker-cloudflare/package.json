{
  "name": "@xagent/worker-cloudflare",
  "version": "0.1.0",
  "description": "XAgent Worker on Cloudflare",
  "main": "dist/index.js",
  "scripts": {
    "prepare:pi-worker": "node scripts/prepare-pi-worker.mjs",
    "prepare:sdk": "cd ../agent-sdk && npm run build",
    "predev": "npm run prepare:sdk && npm run prepare:pi-worker",
    "prebuild": "npm run prepare:sdk && npm run prepare:pi-worker",
    "predeploy": "npm run prepare:sdk && npm run prepare:pi-worker",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@xagent/agent-sdk": "file:../agent-sdk",
    "@xagent/shared-orchestrator": "file:../shared-orchestrator",
    "@mariozechner/pi-agent-core": "^0.62.0",
    "@mariozechner/pi-ai": "^0.62.0",
    "@sinclair/typebox": "^0.34.48",
    "ethers": "^6.11.0",
    "pi-coding-agent-worker": "file:../../vendor/pi-worker/packages/pi-coding-agent-worker",
    "pi-tui-worker": "file:../../vendor/pi-worker/packages/pi-tui-worker",
    "pi-worker": "file:../../vendor/pi-worker/packages/pi-worker"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250313.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0",
    "wrangler": "^4.77.0"
  }
}

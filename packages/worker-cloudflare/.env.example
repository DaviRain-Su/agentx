# Cloudflare Worker Environment Variables

# Required: X Layer Connection
XLAYER_RPC_URL=https://xlayertestrpc.okx.com
NODE_PRIVATE_KEY=your_ethereum_private_key_here

# Required: Cloudflare AI (free tier available)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_GATEWAY_NAME=gradience-ai
CF_GATEWAY_TOKEN=your_cloudflare_api_token

# Optional: External APIs
ANTHROPIC_API_KEY=your_anthropic_key_optional
COINGECKO_API_KEY=your_coingecko_key_optional

# Feature Flags
DEMO_MODE=false
